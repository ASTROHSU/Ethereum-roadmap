---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import TaiwanPulse from '../components/TaiwanPulse.astro';
import { sourceManifest, taipeiTime } from '../lib/radar';
import { activeChanges, currentState, directionMap, directionSources, stateObservation } from '../lib/current-state';
---
<SiteLayout description="直接看懂以太坊現在正在改什麼、會影響什麼，以及後續正往哪裡走。">
  <SiteHeader />
  <main>
    <section class="radar-grid border-b border-ink/10">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 lg:grid-cols-[1.15fr_.85fr] lg:px-8 lg:py-20">
        <div>
          <p class="text-sm font-bold text-teal">以太坊現況判讀 · 觀測日 {stateObservation.observedAt}</p>
          <h1 class="mt-5 max-w-3xl text-5xl font-extrabold leading-[1.12] tracking-tight sm:text-6xl">以太坊現在改的，<br/><span class="text-teal">不是另一條更快的鏈。</span></h1>
          <p class="mt-6 max-w-2xl text-xl leading-8 text-ink-soft">{stateObservation.summary}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="rounded-full bg-ink px-5 py-3 text-sm font-bold text-white no-underline hover:bg-teal" href="#now">現在正在改什麼 →</a>
            <a class="rounded-full border border-ink/20 px-5 py-3 text-sm font-bold no-underline hover:border-teal hover:text-teal" href="#direction">它正往哪裡走</a>
          </div>
          <p class="mt-6 border-l-2 border-coral pl-3 text-sm leading-6 text-ink-soft">{stateObservation.caveat}</p>
        </div>
        <TaiwanPulse />
      </div>
    </section>

    <section id="now" class="mx-auto max-w-6xl px-5 py-16 lg:px-8">
      <div class="max-w-3xl"><p class="text-sm font-bold text-coral">現在已經是什麼樣子</p><h2 class="mt-2 text-3xl font-extrabold">L1 提供資料、安全與結算；L2 把擴容帶到使用者面前。</h2><p class="mt-3 leading-7 text-ink-soft">這不是未來想像，而是已經在運作中的結構。真正要追的是：兩層之間的能力、成本與信任假設正怎麼改。</p></div>
      <div class="mt-8 grid gap-4 lg:grid-cols-2">
        {Object.values(currentState).map((item) => <article class="rounded-3xl border border-ink/10 p-7"><p class="text-xs font-bold text-teal">{item.kind}</p><h3 class="mt-3 text-2xl font-bold">{item.title}</h3><p class="mt-4 font-semibold leading-7">{item.fact}</p><div class="mt-5 border-l-2 border-coral pl-4"><p class="text-xs font-bold text-coral">這代表什麼</p><p class="mt-2 leading-7 text-ink-soft">{item.meaning}</p></div><a class="mt-6 inline-block text-sm font-bold text-teal" href={item.source.url} target="_blank">依據：{item.source.label} →</a></article>)}
      </div>
    </section>

    <section class="border-y border-ink/10 bg-mist"><div class="mx-auto max-w-6xl px-5 py-16 lg:px-8"><div class="max-w-3xl"><p class="text-sm font-bold text-teal">此刻的協議工作</p><h2 class="mt-2 text-3xl font-extrabold">Glamsterdam 正在改的兩個底層規則</h2><p class="mt-3 leading-7 text-ink-soft">Forkcast 目前列出 10 項已排入下一輪開發網的提案、13 項仍在考慮。這裡先放兩個能說明方向的核心變化；它們是開發網工作，不是主網公告。</p></div><div class="mt-8 grid gap-5 lg:grid-cols-2">{activeChanges.map((item) => <article class="rounded-3xl bg-paper p-7 shadow-sm"><p class="text-xs font-bold text-coral">{item.kind} · {item.id}</p><h3 class="mt-3 text-2xl font-bold">{item.title}</h3><p class="mt-4 font-semibold leading-7">{item.short}</p><dl class="mt-6 space-y-5"><div><dt class="text-xs font-bold text-teal">為什麼要改</dt><dd class="mt-2 leading-7 text-ink-soft">{item.why}</dd></div><div><dt class="text-xs font-bold text-teal">誰會先感受到</dt><dd class="mt-2 leading-7 text-ink-soft">{item.impact}</dd></div><div class="border-t border-ink/10 pt-4"><dt class="text-xs font-bold text-coral">進度界線</dt><dd class="mt-2 leading-7 text-ink-soft">{item.status}</dd></div></dl><a class="mt-6 inline-block text-sm font-bold text-teal" href={item.source.url} target="_blank">依據：{item.source.label} →</a></article>)}</div></div></section>

    <section id="direction" class="mx-auto max-w-6xl px-5 py-16 lg:px-8"><div class="max-w-3xl"><p class="text-sm font-bold text-coral">接下來正往哪裡走</p><h2 class="mt-2 text-3xl font-extrabold">不是一張確定時程表，而是三個被持續對齊的能力目標。</h2><p class="mt-3 leading-7 text-ink-soft">官方路線圖與 Strawmap 都指出方向；後者更延伸到未來數年，但明確是草案。這一層回答「為什麼前面的 EIP 值得看」，不把它寫成明天會上線的功能。</p></div><div class="mt-8 grid gap-4 lg:grid-cols-3">{directionMap.map((item, index) => <article class="border-t-4 border-teal bg-mist p-6"><p class="text-xs font-bold text-teal">0{index + 1}</p><h3 class="mt-5 text-xl font-bold">{item.title}</h3><p class="mt-3 leading-7 text-ink-soft">{item.detail}</p></article>)}</div><div class="mt-7 flex flex-wrap gap-5 text-sm font-bold text-teal">{directionSources.map((source) => <a href={source.url} target="_blank">依據：{source.label} →</a>)}</div></section>

    <section class="border-t border-ink/10 bg-ink text-paper"><div class="mx-auto max-w-6xl px-5 py-12 lg:px-8"><p class="max-w-3xl text-2xl font-bold leading-9">你不需要追完每份規格；但在規則變成產品預設以前，先看懂它要解決什麼，才看得懂後來為何改變。</p><a href="/evidence/" class="mt-6 inline-block rounded-full bg-paper px-5 py-3 text-sm font-bold text-ink no-underline">查看每一項依據與界線 →</a></div></section>
  </main>
  <footer class="border-t border-ink/10 px-5 py-8 text-center text-xs text-ink-soft">Forkcast 快照：{taipeiTime(sourceManifest.observed_at)} · 本站現況判讀觀測日：{stateObservation.observedAt} · <a href="/evidence/">來源與閱讀界線</a></footer>
</SiteLayout>
