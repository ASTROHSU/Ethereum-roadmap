---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { audienceGuides, primaryUpgrade, recentSignals, signalBrief, signalStateLabel } from '../../lib/radar';
export function getStaticPaths() { return audienceGuides.map((guide) => ({ params: { audience: guide.slug }, props: { guide } })); }
const { guide } = Astro.props;
const signals = recentSignals('Glamsterdam', 2);
---
<SiteLayout title={`${guide.label}｜以太坊升級雷達`} description={`${guide.label}現在值得先理解的以太坊變化。`}>
  <SiteHeader />
  <main class="mx-auto max-w-5xl px-5 py-12 lg:px-8 lg:py-16">
    <a href="/#today" class="text-sm font-bold text-teal">← 回到今天的以太坊</a>
    <p class="mt-10 text-sm font-bold text-coral">{guide.eyebrow}</p>
    <h1 class="mt-4 text-5xl font-extrabold tracking-tight">如果你是<br/>{guide.label}</h1>
    <p class="mt-5 max-w-2xl text-xl leading-8 text-ink-soft">{guide.summary}</p>
    <section class="mt-12 grid gap-5 md:grid-cols-2"><article class="rounded-3xl bg-ink p-7 text-paper"><p class="text-xs font-bold text-sun">現在值得知道</p><h2 class="mt-3 text-2xl font-bold">{primaryUpgrade.name}</h2><p class="mt-3 leading-7 text-paper/80">{primaryUpgrade.short}</p><a href="/upgrade/glamsterdam/" class="mt-6 inline-block font-bold text-sun">看升級脈絡 →</a></article><article class="rounded-3xl border border-coral/30 bg-paper p-7"><p class="text-xs font-bold text-coral">晚一點才看</p><h2 class="mt-3 text-2xl font-bold">你可能會少了什麼？</h2><p class="mt-3 leading-7 text-ink-soft">{guide.lateCost}</p></article></section>
    <section class="mt-14"><p class="text-sm font-bold text-teal">先追這兩項</p><div class="mt-5 grid gap-4 md:grid-cols-2">{signals.map((signal) => <article class="rounded-2xl bg-mist p-5"><p class="text-xs font-bold text-teal">EIP-{signal.id} · {signalStateLabel(signal)}</p><h3 class="mt-3 font-bold">{signalBrief(signal).title}</h3><p class="mt-3 text-sm leading-6 text-ink-soft">{signalBrief(signal).summary}</p>{signal.discussionLink && <a class="mt-4 inline-block text-sm font-bold text-teal" target="_blank" href={signal.discussionLink}>查看依據 →</a>}</article>)}</div></section>
  </main>
</SiteLayout>
