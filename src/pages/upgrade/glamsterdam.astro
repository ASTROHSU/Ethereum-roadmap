---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import TaiwanPulse from '../../components/TaiwanPulse.astro';
import { primaryUpgrade, recentSignals, signalBrief, signalStateLabel } from '../../lib/radar';
import { sourceMap } from '../../lib/source-map';
const signals = recentSignals('Glamsterdam', 2);
---
<SiteLayout title="Glamsterdam｜以太坊升級雷達" description="理解 Glamsterdam 正在形成什麼，以及它為何值得現在開始看。">
  <SiteHeader />
  <main class="mx-auto max-w-6xl px-5 py-12 lg:px-8 lg:py-16">
    <a href="/#today" class="text-sm font-bold text-teal">← 回到今天的以太坊</a>
    <div class="mt-8 grid gap-10 lg:grid-cols-[1.2fr_.8fr]"><section><p class="text-sm font-bold text-coral">正在形成的升級</p><h1 class="mt-4 text-5xl font-extrabold tracking-tight">{primaryUpgrade.name}</h1><p class="mt-4 text-2xl font-bold text-teal">{primaryUpgrade.phase}</p><p class="mt-7 max-w-2xl text-lg leading-8 text-ink-soft">它正在決定下一輪升級會納入哪些改變。現在先理解規格如何形成，之後才看得懂產品與基礎設施為何要適配。</p><div class="mt-9 grid gap-4 sm:grid-cols-2"><div class="rounded-2xl bg-mist p-5"><p class="text-xs font-bold text-teal">現在要看什麼</p><p class="mt-3 leading-7">哪些提案開始進入客戶端實作與測試。</p></div><div class="rounded-2xl bg-ink p-5 text-paper"><p class="text-xs font-bold text-sun">為什麼現在看</p><p class="mt-3 leading-7 text-paper/85">進入實作後，討論通常只剩如何適配。</p></div></div></section><TaiwanPulse /></div>
    <section class="mt-16 rounded-3xl bg-mist p-7 sm:p-10"><p class="text-sm font-bold text-teal">可回查的進度</p><h2 class="mt-3 text-3xl font-extrabold">現在只需要看這兩件事</h2><div class="mt-7 space-y-3">{signals.map((signal) => <article class="flex flex-col justify-between gap-3 rounded-xl bg-paper p-5 sm:flex-row sm:items-center"><div><p class="text-xs font-bold text-teal">EIP-{signal.id} · {signalStateLabel(signal)}</p><h3 class="mt-1 font-bold">{signalBrief(signal).title}</h3><p class="mt-1 text-sm text-ink-soft">{signalBrief(signal).summary}</p></div><a href={signal.discussionLink} target="_blank" class="shrink-0 text-sm font-bold text-teal">原始討論 →</a></article>)}</div><a href={sourceMap.forkcast.url} target="_blank" class="mt-7 inline-block text-sm font-bold text-teal">查看 Forkcast 的完整進度 →</a></section>
  </main>
</SiteLayout>
