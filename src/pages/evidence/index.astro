---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { sourceManifest, taipeiTime } from '../../lib/radar';
import { activeChanges, currentState, directionSources, stateObservation } from '../../lib/current-state';
import { sourceMap } from '../../lib/source-map';
const sources = [sourceMap.forkcast, sourceMap.strawmap, sourceMap.l2beat, sourceMap.galaxy];
---
<SiteLayout title="資料來源｜以太坊升級雷達" description="每一項以太坊現況與未來方向，都能回到原始資料與閱讀界線。">
  <SiteHeader />
  <main class="mx-auto max-w-5xl px-5 py-12 lg:px-8 lg:py-16">
    <p class="text-sm font-bold text-teal">資料來源</p><h1 class="mt-4 text-5xl font-extrabold tracking-tight">先看結論，也能回查依據。</h1><p class="mt-5 max-w-3xl text-lg leading-8 text-ink-soft">首頁的「現況判讀」是本站跨來源整理。每個主張都標明它是已上線、正在測試或規劃方向，避免把草案寫成現況。</p>

    <section class="mt-12 rounded-3xl bg-ink p-7 text-paper sm:p-10"><p class="text-xs font-bold text-sun">本次判讀 · {stateObservation.observedAt}</p><p class="mt-3 max-w-3xl text-2xl font-bold leading-9">{stateObservation.summary}</p><p class="mt-4 text-sm leading-6 text-paper/70">{stateObservation.caveat}</p></section>

    <section class="mt-14"><h2 class="text-3xl font-extrabold">首頁主張從哪裡來</h2><div class="mt-7 grid gap-4 md:grid-cols-3"><article class="border-t-4 border-teal bg-mist p-5"><p class="text-xs font-bold text-teal">已上線</p><h3 class="mt-3 font-bold">L1 與 L2 現況</h3><p class="mt-3 text-sm leading-6 text-ink-soft">{currentState.fusaka.fact} {currentState.l2.fact}</p></article><article class="border-t-4 border-coral bg-mist p-5"><p class="text-xs font-bold text-coral">正在測試</p><h3 class="mt-3 font-bold">Glamsterdam 的兩個核心工作</h3><p class="mt-3 text-sm leading-6 text-ink-soft">{activeChanges.map((item) => item.id).join('、')} 已排入下一輪開發網，不等於主網已排程。</p></article><article class="border-t-4 border-sun bg-mist p-5"><p class="text-xs font-bold text-sun">規劃方向</p><h3 class="mt-3 font-bold">長期能力目標</h3><p class="mt-3 text-sm leading-6 text-ink-soft">官方路線圖與 Strawmap 說明方向與依賴；時間與最終範圍仍可能改變。</p></article></div></section>

    <section class="mt-14 grid gap-4 sm:grid-cols-2">{sources.map((source) => <article class="rounded-2xl border border-ink/10 p-6"><p class:list={['text-xs font-bold', source.layer === '第三方解讀' ? 'text-coral' : 'text-teal']}>{source.layer}</p><h2 class="mt-3 text-2xl font-bold">{source.name}</h2><p class="mt-3 font-semibold">{source.role}</p><p class="mt-3 leading-7 text-ink-soft">{source.use}</p><p class="mt-4 border-t border-ink/10 pt-4 text-sm leading-6 text-ink-soft">閱讀界線：{source.limit}</p><a href={source.url} target="_blank" class="mt-5 inline-block text-sm font-bold text-teal">查看原始來源 →</a></article>)}</section>

    <section class="mt-14 rounded-3xl bg-ink p-7 text-paper sm:p-10"><p class="text-xs font-bold text-sun">Forkcast 快照</p><dl class="mt-6 grid gap-5 sm:grid-cols-3"><div><dt class="text-sm text-paper/70">最後成功同步</dt><dd class="mt-1 font-bold">{taipeiTime(sourceManifest.observed_at)}</dd></div><div><dt class="text-sm text-paper/70">已驗證提案</dt><dd class="mt-1 text-2xl font-extrabold">{sourceManifest.snapshot.eips} 項</dd></div><div><dt class="text-sm text-paper/70">測試網</dt><dd class="mt-1 text-2xl font-extrabold">{sourceManifest.snapshot.devnets} 個</dd></div></dl></section>

    <section class="mt-14"><h2 class="text-3xl font-extrabold">本站如何整理</h2><div class="mt-7 grid gap-4 md:grid-cols-3"><article class="border-t-4 border-teal bg-mist p-5"><h3 class="font-bold">原始資料</h3><p class="mt-3 text-sm leading-6 text-ink-soft">來源直接提供的狀態、提案、風險或路線圖。</p></article><article class="border-t-4 border-sun bg-mist p-5"><h3 class="font-bold">跨來源整理</h3><p class="mt-3 text-sm leading-6 text-ink-soft">把已上線、正在測試與規劃方向分開，才不會把不同時間尺度混成「現在」。</p></article><article class="border-t-4 border-coral bg-mist p-5"><h3 class="font-bold">本站解讀</h3><p class="mt-3 text-sm leading-6 text-ink-soft">說明它改變什麼、誰會先感受到；連同不確定性一起寫出來。</p></article></div><div class="mt-7 flex flex-wrap gap-5 text-sm font-bold text-teal">{directionSources.map((source) => <a href={source.url} target="_blank">{source.label} →</a>)}</div></section>
  </main>
</SiteLayout>
