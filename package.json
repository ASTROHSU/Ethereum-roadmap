{
  "name": "ethereum-upgrade-radar",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "compile-eips": "node scripts/compile-eips.mjs",
    "generate-manifest": "node scripts/build-source-manifest.mjs",
    "dev": "npm run compile-eips && npm run generate-manifest && astro dev",
    "build": "npm run compile-eips && npm run generate-manifest && astro check && astro build",
    "check": "astro check",
    "preview": "astro preview",
    "validate-eips": "node scripts/validate-eip-metadata.mjs",
    "sync-calls": "node scripts/sync-call-assets.mjs",
    "sync-forkcast-eips": "node scripts/sync-forkcast-eips.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.1.7",
    "astro": "^5.18.2",
    "tailwindcss": "^4.1.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "ajv": "^8.17.1",
    "playwright": "^1.61.1",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3"
  }
}
