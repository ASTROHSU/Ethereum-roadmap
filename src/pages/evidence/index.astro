---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { sourceManifest, taipeiTime } from '../../lib/radar';
import { sourceMap } from '../../lib/source-map';
const sources = [sourceMap.forkcast, sourceMap.strawmap, sourceMap.l2beat, sourceMap.galaxy];
---
<SiteLayout title="資料來源｜以太坊升級雷達" description="每一項以太坊現況與未來方向，都能回到原始資料與閱讀界線。">
  <SiteHeader />
  <main class="mx-auto max-w-5xl px-5 py-12 lg:px-8 lg:py-16">
    <p class="text-sm font-bold text-teal">資料來源</p><h1 class="mt-4 text-5xl font-extrabold tracking-tight">先分清楚：現在、方向與解讀。</h1><p class="mt-5 max-w-3xl text-lg leading-8 text-ink-soft">不同來源回答不同問題。本站不把草案當時程，也不把第三方觀點寫成協議事實。</p>

    <section class="mt-12 grid gap-4 sm:grid-cols-2">{sources.map((source) => <article class="rounded-2xl border border-ink/10 p-6"><p class:list={['text-xs font-bold', source.layer === '第三方解讀' ? 'text-coral' : 'text-teal']}>{source.layer}</p><h2 class="mt-3 text-2xl font-bold">{source.name}</h2><p class="mt-3 font-semibold">{source.role}</p><p class="mt-3 leading-7 text-ink-soft">{source.use}</p><p class="mt-4 border-t border-ink/10 pt-4 text-sm leading-6 text-ink-soft">閱讀界線：{source.limit}</p><a href={source.url} target="_blank" class="mt-5 inline-block text-sm font-bold text-teal">查看原始來源 →</a></article>)}</section>

    <section class="mt-14 rounded-3xl bg-ink p-7 text-paper sm:p-10"><p class="text-xs font-bold text-sun">目前的 Forkcast 快照</p><dl class="mt-6 grid gap-5 sm:grid-cols-3"><div><dt class="text-sm text-paper/70">最後成功同步</dt><dd class="mt-1 font-bold">{taipeiTime(sourceManifest.observed_at)}</dd></div><div><dt class="text-sm text-paper/70">已驗證提案</dt><dd class="mt-1 text-2xl font-extrabold">{sourceManifest.snapshot.eips} 項</dd></div><div><dt class="text-sm text-paper/70">測試網</dt><dd class="mt-1 text-2xl font-extrabold">{sourceManifest.snapshot.devnets} 個</dd></div></dl></section>

    <section class="mt-14"><h2 class="text-3xl font-extrabold">本站如何整理</h2><div class="mt-7 grid gap-4 md:grid-cols-3"><article class="border-t-4 border-teal bg-mist p-5"><h3 class="font-bold">原始資料</h3><p class="mt-3 text-sm leading-6 text-ink-soft">來源直接提供的狀態、提案、風險或路線圖。</p></article><article class="border-t-4 border-sun bg-mist p-5"><h3 class="font-bold">跨來源整理</h3><p class="mt-3 text-sm leading-6 text-ink-soft">把不同時間尺度的資料並列，讓今天與接下來能分開理解。</p></article><article class="border-t-4 border-coral bg-mist p-5"><h3 class="font-bold">本站解讀</h3><p class="mt-3 text-sm leading-6 text-ink-soft">說明為何值得提早看，但不把方向寫成已經發生的結果。</p></article></div></section>
  </main>
</SiteLayout>
