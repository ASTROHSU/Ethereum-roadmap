---
const path = Astro.url.pathname;
const items = [
  { href: '/#today', label: '今天的以太坊' },
  { href: '/#future', label: '接下來' },
  { href: '/evidence/', label: '資料來源' },
];
---
<header class="border-b border-ink/10 bg-paper/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4 lg:px-8">
    <a class="group flex items-center gap-3 no-underline" href="/">
      <span class="grid size-9 place-items-center rounded-full bg-ink text-sm font-bold text-paper transition group-hover:bg-teal">雷</span>
      <strong class="text-sm tracking-[.08em]">以太坊升級雷達</strong>
    </a>
    <nav aria-label="主選單" class="hidden items-center gap-5 text-sm md:flex">
      {items.map((item) => <a class:list={['no-underline hover:text-teal', path === item.href ? 'font-bold text-teal' : 'text-ink-soft']} href={item.href}>{item.label}</a>)}
    </nav>
    <a href="/evidence/" class="rounded-full border border-teal/30 px-3 py-1.5 text-xs font-semibold text-teal no-underline hover:bg-teal hover:text-white">查看依據</a>
  </div>
  <nav aria-label="行動版主選單" class="flex gap-5 overflow-x-auto border-t border-ink/10 px-5 py-3 text-sm md:hidden">
    {items.map((item) => <a class:list={['shrink-0 no-underline hover:text-teal', path === item.href ? 'font-bold text-teal' : 'text-ink-soft']} href={item.href}>{item.label}</a>)}
  </nav>
</header>
